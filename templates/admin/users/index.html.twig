{% extends 'admin/base.html.twig' %}
{% block topbar_title %}Utilisateurs{% endblock %}
{% block body %}
<div class="p-4">
    <h2 class="fw-bold mb-4">👥 Utilisateurs</h2>
    <table class="admin-table">
        <thead><tr><th>#</th><th>Email</th><th>Rôles</th><th>Actions</th></tr></thead>
        <tbody>
        {% for u in users %}
        <tr>
            <td>{{ u.id }}</td>
            <td>{{ u.email }}</td>
            <td>
                {% for role in u.roles %}
                    <span class="badge" style="background:{{ role == 'ROLE_ADMIN' ? '#f59e0b' : '#333' }};">{{ role }}</span>
                {% endfor %}
            </td>
            <td>
                <form method="post" action="{{ path('admin_user_delete', {id: u.id}) }}" style="display:inline"
                      onsubmit="return confirm('Supprimer cet utilisateur ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete'~u.id) }}">
                    <button class="btn btn-sm" style="background:#dc3545; color:#fff;">🗑️</button>
                </form>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}