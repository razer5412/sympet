{% extends 'admin/base.html.twig' %}
{% block topbar_title %}Commandes
{% endblock %}
{% block body %}
	<div class="p-4">
		<h2 class="fw-bold mb-4">📦 Commandes</h2>

		{% for statut, liste in {'En attente': enAttente, 'Confirmées': confirmees, 'Livrées': livrees} %}
			<h5 class="mt-4 mb-3" style="color:#1D9E75;">{{ statut }}
				({{ liste|length }})</h5>
			{% if liste|length == 0 %}
				<p style="color:#555;">Aucune commande.</p>
			{% else %}
				<table class="admin-table mb-4">
					<thead>
						<tr>
							<th>#</th>
							<th>Client</th>
							<th>Total</th>
							<th>Date</th>
							<th>Statut</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for c in liste %}
							<tr>
								<td>#{{ c.id }}</td>
								<td>{{ c.user.email }}</td>
								<td style="color:#1D9E75;">{{ c.total|number_format(2,',',' ') }}
									TND</td>
								<td style="color:#888;">{{ c.createdAt|date('d/m/Y H:i') }}</td>
								<td>
									<span class="badge" style="background:#1D9E75;">{{ c.statut }}</span>
								</td>
								<td>
									<a href="{{ path('admin_commande_detail', {id: c.id}) }}" class="btn btn-sm btn-success" title="Voir détails">
										👁️ Voir
									</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			{% endif %}
		{% endfor %}
	</div>
{% endblock %}
