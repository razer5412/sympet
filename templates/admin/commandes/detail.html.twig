{% extends 'admin/base.html.twig' %}
{% block topbar_title %}Commande #{{ commande.id }}
{% endblock %}

{% block body %}
	<div class="p-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h2 class="fw-bold">📦 Commande #{{ commande.id }}</h2>
			<a href="{{ path('admin_commandes') }}" class="btn btn-secondary">← Retour</a>
		</div>

		<div
			class="row">
			<!-- Infos client et dates -->
			<div class="col-md-6 mb-4">
				<div class="card bg-dark border-secondary text-white">
					<div class="card-header" style="background: #1D9E75;">
						<h5 class="mb-0">Informations</h5>
					</div>
					<div class="card-body">
						<p>
							<strong>Client:</strong>
							{{ commande.user.email }}</p>
						<p>
							<strong>Nom:</strong>
							{{ commande.user.nom ?? 'N/A' }}</p>
						<p>
							<strong>Date:</strong>
							{{ commande.createdAt|date('d/m/Y H:i') }}</p>
						<p>
							<strong>Statut actuel:</strong>
							<span class="badge" style="background: #1D9E75; padding: 5px 10px;">
								{{ commande.statut|upper }}
							</span>
						</p>
					</div>
				</div>
			</div>

			<!-- Changement de statut -->
			<div class="col-md-6 mb-4">
				<div class="card bg-dark border-warning text-white">
					<div class="card-header" style="background: #f39c12;">
						<h5 class="mb-0">Changer le statut</h5>
					</div>
					<div class="card-body">
						<form method="POST" action="{{ path('admin_commande_statut', {id: commande.id}) }}">
							<div class="mb-3">
								<label for="statut" class="form-label">Nouveau statut:</label>
								<select class="form-select bg-secondary text-white" id="statut" name="statut" required>
									<option value="">-- Choisir un statut --</option>
									<option value="en_attente" {% if commande.statut == 'en_attente' %} selected {% endif %}>
										En attente
									</option>
									<option value="confirmée" {% if commande.statut == 'confirmée' %} selected {% endif %}>
										Confirmée
									</option>
									<option value="livrée" {% if commande.statut == 'livrée' %} selected {% endif %}>
										Livrée
									</option>
									<option value="annulée" {% if commande.statut == 'annulée' %} selected {% endif %}>
										Annulée
									</option>
								</select>
							</div>
							<button type="submit" class="btn btn-success w-100">Mettre à jour</button>
						</form>
					</div>
				</div>
			</div>
		</div>

		<!-- Détails des articles -->
		<div class="card bg-dark border-secondary text-white mb-4">
			<div class="card-header" style="background: #1D9E75;">
				<h5 class="mb-0">Articles de la commande</h5>
			</div>
			<div class="card-body">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Produit</th>
							<th>Quantité</th>
							<th>Prix unitaire</th>
							<th>Sous-total</th>
						</tr>
					</thead>
					<tbody>
						{% for ligne in commande.ligneCommandes %}
							<tr>
								<td>{{ ligne.produit.nom }}</td>
								<td>{{ ligne.quantite }}</td>
								<td style="color: #1D9E75;">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }}
									DT</td>
								<td style="color: #1D9E75; font-weight: bold;">
									{{ (ligne.prixUnitaire * ligne.quantite)|number_format(2, ',', ' ') }}
									DT
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>

				<div style="text-align: right; margin-top: 20px; border-top: 2px solid #1D9E75; padding-top: 15px;">
					<h4 style="color: #1D9E75;">
						Total:
						<strong>{{ commande.total|number_format(2, ',', ' ') }}
							DT</strong>
					</h4>
				</div>
			</div>
		</div>

	</div>
{% endblock %}
