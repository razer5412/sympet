{% extends 'admin/base.html.twig' %}
{% block topbar_title %}{{ titre }}{% endblock %}
{% block body %}
<div class="p-4" style="max-width:600px;">
    <h2 class="fw-bold mb-4">{{ titre }}</h2>
    {{ form_start(form, {attr: {style: 'display:flex; flex-direction:column; gap:16px;'}}) }}
        {% for field in form %}
            <div>
                {{ form_label(field, null, {label_attr: {style: 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                {{ form_widget(field, {attr: {style: 'background:#1a1a1a; border:1px solid #333; color:#fff; border-radius:8px; padding:10px 14px; width:100%;'}}) }}
                {{ form_errors(field) }}
            </div>
        {% endfor %}
        <button type="submit" class="btn mt-2" style="background:#1D9E75; color:#fff;">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}