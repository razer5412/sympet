{% extends 'admin/base.html.twig' %}
{% block topbar_title %}Produits{% endblock %}
{% block body %}
<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">🛍️ Produits</h2>
        <a href="{{ path('admin_produit_new') }}" class="btn" style="background:#1D9E75; color:#fff;">+ Ajouter</a>
    </div>
    <table class="admin-table">
        <thead><tr><th>#</th><th>Nom</th><th>Catégorie</th><th>Prix</th><th>Stock</th><th>Actions</th></tr></thead>
        <tbody>
        {% for p in produits %}
        <tr>
            <td>{{ p.id }}</td>
            <td>{{ p.nom }}</td>
            <td>{{ p.categorie ? p.categorie.nom : '—' }}</td>
            <td style="color:#1D9E75;">{{ p.prix|number_format(2,',',' ') }} TND</td>
            <td><span class="badge" style="background:{{ p.stock > 0 ? '#1D9E75' : '#dc3545' }};">{{ p.stock }}</span></td>
            <td>
                <a href="{{ path('admin_produit_edit', {id: p.id}) }}" class="btn btn-sm btn-outline-light me-1">✏️</a>
                <form method="post" action="{{ path('admin_produit_delete', {id: p.id}) }}" style="display:inline"
                      onsubmit="return confirm('Supprimer ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete'~p.id) }}">
                    <button class="btn btn-sm" style="background:#dc3545; color:#fff;">🗑️</button>
                </form>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}