<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin – SymPET{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body { background:#0a0a0a; color:#fff; font-family:sans-serif; margin:0; display:flex; min-height:100vh; }

        /* Sidebar */
        .sidebar {
            width: 240px; background:#111; border-right:1px solid #222;
            display:flex; flex-direction:column; padding:24px 0; position:fixed;
            top:0; left:0; height:100vh;
        }
        .sidebar-brand {
            font-size:20px; font-weight:700; padding:0 24px 24px;
            border-bottom:1px solid #222; color:#fff;
        }
        .sidebar-brand span { color:#1D9E75; }
        .sidebar-nav { flex:1; padding:16px 0; }
        .sidebar-link {
            display:flex; align-items:center; gap:10px;
            padding:12px 24px; color:#aaa; text-decoration:none;
            font-size:14px; transition:all 0.2s;
        }
        .sidebar-link:hover, .sidebar-link.active {
            color:#fff; background:#1a1a1a; border-left:3px solid #1D9E75;
        }
        .sidebar-section {
            padding:16px 24px 8px; font-size:11px;
            color:#444; text-transform:uppercase; letter-spacing:1px;
        }

        /* Main */
        .main { margin-left:240px; flex:1; min-height:100vh; }

        /* Topbar */
        .topbar {
            background:#111; border-bottom:1px solid #222;
            padding:16px 24px; display:flex; align-items:center;
            justify-content:space-between;
        }
        .topbar h6 { margin:0; color:#aaa; font-size:14px; }

        /* KPI */
        .kpi-card {
            background:#111; border:1px solid #222; border-radius:12px;
            padding:24px; text-align:center; transition:border-color 0.2s;
        }
        .kpi-card:hover { border-color:#1D9E75; }
        .kpi-icon { font-size:2rem; margin-bottom:8px; }
        .kpi-value { font-size:1.6rem; font-weight:700; color:#1D9E75; }
        .kpi-label { color:#888; font-size:13px; margin-top:4px; }

        /* Chart card */
        .chart-card {
            background:#111; border:1px solid #222;
            border-radius:12px; padding:24px;
        }

        /* Table */
        .admin-table { width:100%; border-collapse:collapse; }
        .admin-table th {
            background:#1a1a1a; color:#aaa; font-size:12px;
            text-transform:uppercase; padding:12px 16px; text-align:left;
        }
        .admin-table td { padding:14px 16px; border-bottom:1px solid #1a1a1a; color:#ddd; }
        .admin-table tr:hover td { background:#0f0f0f; }

        /* Flash */
        .flash-success {
            background:#0f3d2e; border:1px solid #1D9E75;
            color:#1D9E75; padding:12px 16px; border-radius:8px; margin:16px 24px 0;
        }
    </style>
</head>
<body>

<aside class="sidebar">
    <div class="sidebar-brand">🐾 Sym<span>PET</span> <small style="color:#444;font-size:11px;">Admin</small></div>
    <nav class="sidebar-nav">
        <div class="sidebar-section">Principal</div>
        <a class="sidebar-link {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}"
           href="{{ path('admin_dashboard') }}">📊 Dashboard</a>

        <div class="sidebar-section">Catalogue</div>
        <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'admin_categorie' ? 'active' : '' }}"
           href="{{ path('admin_categories') }}">🏷️ Catégories</a>

        <div class="sidebar-section">Gestion</div>
        <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'admin_produit' ? 'active' : '' }}"
           href="{{ path('admin_produits') }}">🛍️ Produits</a>
        <a class="sidebar-link {{ app.request.attributes.get('_route') == 'admin_commandes' ? 'active' : '' }}"
           href="{{ path('admin_commandes') }}">📦 Commandes</a>
        <a class="sidebar-link {{ app.request.attributes.get('_route') == 'admin_users' ? 'active' : '' }}"
           href="{{ path('admin_users') }}">👥 Utilisateurs</a>

        <div class="sidebar-section">Site</div>
        <a class="sidebar-link" href="{{ path('home') }}">🌐 Voir le site</a>
    </nav>
</aside>

<div class="main">
    <div class="topbar">
        <h6>{% block topbar_title %}Dashboard{% endblock %}</h6>
        <span style="color:#aaa; font-size:13px;">👤 Admin</span>
    </div>

    {% for msg in app.flashes('success') %}
        <div class="flash-success">✓ {{ msg }}</div>
    {% endfor %}

    {% block body %}{% endblock %}
</div>

</body>
</html>