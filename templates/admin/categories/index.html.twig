{% extends 'admin/base.html.twig' %}
{% block topbar_title %}Catégories{% endblock %}
{% block body %}
<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">🏷️ Catégories</h2>
        <a href="{{ path('admin_categorie_new') }}" class="btn" style="background:#1D9E75; color:#fff;">+ Ajouter</a>
    </div>
    <table class="admin-table">
        <thead><tr><th>#</th><th>Nom</th><th>Actions</th></tr></thead>
        <tbody>
        {% for c in categories %}
        <tr>
            <td>{{ c.id }}</td>
            <td>{{ c.nom }}</td>
            <td>
                <a href="{{ path('admin_categorie_edit', {id: c.id}) }}" class="btn btn-sm btn-outline-light me-1">✏️</a>
                <form method="post" action="{{ path('admin_categorie_delete', {id: c.id}) }}" style="display:inline"
                      onsubmit="return confirm('Supprimer ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete'~c.id) }}">
                    <button class="btn btn-sm" style="background:#dc3545; color:#fff;">🗑️</button>
                </form>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}