{% extends 'base.html.twig' %}

{% block body %}

<div style="text-align:center; padding: 80px 20px; background:#000;">
    <div style="display:inline-block; background:#0F6E56; color:#fff; padding:4px 16px; border-radius:20px; font-size:13px; margin-bottom:16px;">
        🐶 Nourriture & Accessoires pour animaux
    </div>
    <h1 style="font-size:48px; font-weight:500; margin-bottom:16px;">
        Bienvenue sur <span style="color:#1D9E75">SymPET</span>
    </h1>
    <p style="color:#aaa; font-size:18px; max-width:520px; margin:0 auto 32px;">
        Tout ce dont votre animal a besoin, livré à votre porte.
    </p>
    <div style="display:flex; gap:12px; justify-content:center;">
        <a href="{{ path('app_lister') }}" class="btn btn-success btn-lg">Voir les produits</a>
        <a href="#" class="btn btn-outline-light btn-lg">En savoir plus</a>
    </div>
</div>

<div style="background:#111; padding:48px 20px; border-top:1px solid #222; border-bottom:1px solid #222;">
    <h2 style="text-align:center; font-size:22px; margin-bottom:24px;">Parcourir par catégorie</h2>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:12px; max-width:700px; margin:0 auto;">
        <div style="text-align:center; padding:24px; border:1px solid #333; border-radius:12px; cursor:pointer;">
            <div style="font-size:28px;"></div>
            <div style="font-weight:500; margin-top:8px;">Chiens</div>
            <div style="color:#666; font-size:12px;">24 produits</div>
        </div>
        <div style="text-align:center; padding:24px; border:1px solid #333; border-radius:12px; cursor:pointer;">
            <div style="font-size:28px;"></div>
            <div style="font-weight:500; margin-top:8px;">Chats</div>
            <div style="color:#666; font-size:12px;">18 produits</div>
        </div>
        <div style="text-align:center; padding:24px; border:1px solid #333; border-radius:12px; cursor:pointer;">
            <div style="font-size:28px;"></div>
            <div style="font-weight:500; margin-top:8px;">Poissons</div>
            <div style="color:#666; font-size:12px;">12 produits</div>
        </div>
        <div style="text-align:center; padding:24px; border:1px solid #333; border-radius:12px; cursor:pointer;">
            <div style="font-size:28px;"></div>
            <div style="font-weight:500; margin-top:8px;">Lapins</div>
            <div style="color:#666; font-size:12px;">9 produits</div>
        </div>
    </div>
</div>

<div style="background:#000; padding:48px 20px;">
    <h2 style="text-align:center; font-size:22px; margin-bottom:24px;">Pourquoi choisir SymPET ?</h2>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; max-width:700px; margin:0 auto;">
        <div style="padding:20px; border:1px solid #222; border-radius:12px; background:#111;">
            <div style="font-size:24px; margin-bottom:8px;"></div>
            <div style="font-weight:500; margin-bottom:4px;">Livraison rapide</div>
            <div style="color:#666; font-size:12px;">Commandez aujourd'hui, recevez demain</div>
        </div>
        <div style="padding:20px; border:1px solid #222; border-radius:12px; background:#111;">
            <div style="font-size:24px; margin-bottom:8px;"></div>
            <div style="font-weight:500; margin-bottom:4px;">Produits certifiés</div>
            <div style="color:#666; font-size:12px;">Tous nos produits sont vérifiés</div>
        </div>
        <div style="padding:20px; border:1px solid #222; border-radius:12px; background:#111;">
            <div style="font-size:24px; margin-bottom:8px;"></div>
            <div style="font-weight:500; margin-bottom:4px;">Paiement sécurisé</div>
            <div style="color:#666; font-size:12px;">Stripe & carte bancaire</div>
        </div>
        <div style="padding:20px; border:1px solid #222; border-radius:12px; background:#111;">
            <div style="font-size:24px; margin-bottom:8px;"></div>
            <div style="font-weight:500; margin-bottom:4px;">Suivi commande</div>
            <div style="color:#666; font-size:12px;">Suivez en temps réel</div>
        </div>
    </div>
</div>

{% endblock %}