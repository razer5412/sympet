<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}SymPET
			{% endblock %}
		</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"> {% block stylesheets %}{% endblock %}
		<style>
			body {
				background: #000;
				color: #fff;
				font-family: sans-serif;
			}
			.navbar {
				background: #111 !important;
				border-bottom: 1px solid #222;
			}
			.navbar-brand {
				color: #fff !important;
				font-size: 22px;
			}
			.nav-link {
				color: #aaa !important;
			}
			.nav-link:hover {
				color: #fff !important;
			}
			.btn-outline-light {
				border-color: #444;
				color: #fff;
			}
			.btn-outline-light:hover {
				background: #222;
			}
			.btn-success {
				background: #1D9E75;
				border: none;
			}
			.btn-success:hover {
				background: #0F6E56;
			}
			.search-input {
				background: #1a1a1a;
				border: 1px solid #333;
				color: #fff;
				border-radius: 8px 0 0 8px;
				width: 220px;
			}
			.search-input::placeholder {
				color: #666;
			}
			.search-input:focus {
				background: #1a1a1a;
				border-color: #1D9E75;
				color: #fff;
				box-shadow: none;
				outline: none;
			}
			.search-btn {
				background: #1D9E75;
				border: none;
				border-radius: 0 8px 8px 0;
				color: #fff;
				padding: 0 14px;
			}
			.search-btn:hover {
				background: #0F6E56;
			}
		</style>
	</head>
	<body>

		<nav class="navbar navbar-expand-lg">
			<div class="container">
				<a class="navbar-brand fw-bold" href="{{ path('home') }}">🐾 Sym<span style="color:#1D9E75">PET</span>
				</a>
				<div class="navbar-nav me-auto">
					<a class="nav-link" href="{{ path('home') }}">Accueil</a>
					<a class="nav-link" href="{{ path('app_lister') }}">Produits</a>
				</div>

				<div class="position-relative me-3">
					<form class="d-flex" method="get" action="{{ path('home') }}">
						<input id="searchInput" class="form-control search-input" type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="🔍 Rechercher un produit…" autocomplete="off">
						<button class="search-btn" type="submit">→</button>
					</form>

					<div id="searchDropdown" style="
							                display: none;
							                position: absolute;
							                top: calc(100% + 6px);
							                left: 0;
							                width: 420px;
							                background: #111;
							                border: 1px solid #333;
							                border-radius: 10px;
							                z-index: 9999;
							                max-height: 400px;
							                overflow-y: auto;
							                box-shadow: 0 8px 32px rgba(0,0,0,0.6);
							            ">
						<div id="searchResults"></div>
					</div>
				</div>

				<div class="d-flex gap-2">
					<a href="{{ path('cart_index') }}" class="btn btn-outline-light">🛒 Panier</a>
					<a href="#" class="btn btn-outline-light">Connexion</a>
					<a href="#" class="btn btn-success">S'inscrire</a>
				</div>
			</div>
		</nav>

		{% block body %}{% endblock %}

		<script>
			const input = document.getElementById('searchInput');
const dropdown = document.getElementById('searchDropdown');
const results = document.getElementById('searchResults');
const detailUrlTemplate = '{{ path('app_detail', {'id': '__ID__'}) }}';
let timer;

input.addEventListener('input', () => {
clearTimeout(timer);
const q = input.value.trim();

if (q.length < 2) {
dropdown.style.display = 'none';
return;
}

timer = setTimeout(() => {
fetch(`{{ path('app_produits_search') }}?q=${
encodeURIComponent(q)
}`).then(r => r.json()).then(produits => {
if (produits.length === 0) {
results.innerHTML = `
                        <div style="padding:20px; text-align:center; color:#666;">
                            😿 Aucun produit trouvé
                        </div>`;
} else {
results.innerHTML = produits.slice(0, 6).map(p => {
const detailUrl = detailUrlTemplate.replace('__ID__', encodeURIComponent(p.id));
return `
                        <a href="${detailUrl}"
                           style="display:flex; align-items:center; gap:12px;
                                  padding:12px 16px; text-decoration:none; color:#fff;
                                  border-bottom:1px solid #222;">
                            <div style="font-size:2rem; width:48px; text-align:center;
                                        background:#1a1a1a; border-radius:8px; padding:4px;">
                                🐾
                            </div>
                            <div style="flex:1;">
                                <div style="font-weight:600;">${
p.nom
}</div>
                                <div style="font-size:12px; color:#888;">${
p.categorie ?? ''
}</div>
                            </div>
                            <div style="color:#1D9E75; font-weight:700; white-space:nowrap;">
                                ${
parseFloat(p.prix).toFixed(2)
} TND
                            </div>
                        </a>
                    `;
}).join('');
if (produits.length > 6) {
results.innerHTML += `
                            <a href="{{ path('home') }}?q=${
encodeURIComponent(q)
}"
                               style="display:block; padding:12px; text-align:center;
                                      color:#1D9E75; text-decoration:none; font-size:14px;
                                      border-top:1px solid #222;">
                                Voir tous les ${
produits.length
} résultats →
                            </a>`;
}
} dropdown.style.display = 'block';
});
}, 300);
});

document.addEventListener('click', (e) => {
if (! input.contains(e.target) && ! dropdown.contains(e.target)) {
dropdown.style.display = 'none';
}
});
		</script>

	</body>
</html>
