<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}SymPET{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #000; color: #fff; font-family: sans-serif; }
        .navbar { background: #111 !important; border-bottom: 1px solid #222; }
        .navbar-brand { color: #fff !important; font-size: 22px; }
        .nav-link { color: #aaa !important; }
        .nav-link:hover { color: #fff !important; }
        .btn-outline-light { border-color: #444; color: #fff; }
        .btn-outline-light:hover { background: #222; }
        .btn-success { background: #1D9E75; border: none; }
        .btn-success:hover { background: #0F6E56; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">🐾 Sym<span style="color:#1D9E75">PET</span></a>
        <div class="navbar-nav me-auto">
            <a class="nav-link" href="/">Accueil</a>
            <a class="nav-link" href="#">Produits</a>
            <a class="nav-link" href="#">Catégories</a>
            <a class="nav-link" href="#">Mon compte</a>
            <a class="nav-link" href="#">Mes commandes</a>
        </div>
        <div class="d-flex gap-2">
            <a href="#" class="btn btn-outline-light">🛒 Panier</a>
            <a href="#" class="btn btn-outline-light">Connexion</a>
            <a href="#" class="btn btn-success">S'inscrire</a>
        </div>
    </div>
</nav>

{% block body %}{% endblock %}

</body>
</html>