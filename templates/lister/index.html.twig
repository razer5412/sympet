{% extends 'base.html.twig' %}

{% block title %}Produits – SymPET
{% endblock %}

{% block body %}
	<div class="container py-5">

		<h2 class="fw-bold mb-4">🐾 Tous les produits</h2>
		<p class="text-muted mb-4">{{ produits.totalItemCount }}
			produit{{ produits.totalItemCount > 1 ? 's' : '' }}
			au total</p>

		<form method="get" class="row g-3 mb-4">
			<div class="col-sm-3">
				<label class="form-label text-muted">Prix min</label>
				<input type="number" step="0.01" min="0" name="min_price" value="{{ app.request.query.get('min_price') }}" class="form-control" placeholder="0">
			</div>
			<div class="col-sm-3">
				<label class="form-label text-muted">Prix max</label>
				<input type="number" step="0.01" min="0" name="max_price" value="{{ app.request.query.get('max_price') }}" class="form-control" placeholder="999">
			</div>
			<div class="col-sm-3">
				<label class="form-label text-muted">Catégorie</label>
				<select name="category" class="form-select">
					<option value="">Toutes</option>
					{% for categorie in categories %}
						<option value="{{ categorie.id }}" {{ app.request.query.get('category') == categorie.id ? 'selected' : '' }}>
							{{ categorie.nom }}
						</option>
					{% endfor %}
				</select>
			</div>
			<div class="col-sm-3 d-flex align-items-end gap-2">
				<button type="submit" class="btn btn-success w-100">Filtrer</button>
				<a href="{{ path('app_lister') }}" class="btn btn-outline-light w-100">Réinitialiser</a>
			</div>
		</form>

		<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
			{% for produit in produits %}
				<div class="col">
					<div class="card h-100" style="background:#111; border:1px solid #222; color:#fff;">

						<div class="d-flex align-items-center justify-content-center" style="height:180px; background:#1a1a1a; font-size:3rem;">
							<img src="{{ produit.image }}" width="120">
						</div>

						<div class="card-body d-flex flex-column">
							{% if produit.categorie %}
								<span class="badge mb-2 align-self-start" style="background:#1D9E75;">
									{{ produit.categorie.nom }}
								</span>
							{% endif %}

							<h5 class="card-title">{{ produit.nom }}</h5>

							<p class="card-text small flex-grow-1" style="color:#888;">
								{{ produit.description|slice(0, 80) }}…
							</p>
							<div class="d-flex justify-content-between align-items-center mt-3">
								<span class="fw-bold fs-5" style="color:#1D9E75;">
									{{ produit.prix|number_format(2, ',', ' ') }}
									TND
								</span>
								<span class="badge" style="background:{{ produit.stock > 0 ? '#1D9E75' : '#dc3545' }};">
									{{ produit.stock > 0 ? 'En stock' : 'Rupture' }}
								</span>
							</div>
						</div>

						<div class="card-footer border-0 pb-3" style="background:#111;">
							<a href="{{ path('app_detail', {id: produit.id}) }}" class="btn w-100" style="background:#1D9E75; color:#fff;">
								Voir le détail →
							</a>
                            <a href="{{ path('cart_add', {id: produit.id}) }}"class="btn w-100" style="background:#1D9E75; color:#fff;">🛒 Ajouter au panier</a>
						</div>

					</div>
				</div>
			{% endfor %}
		</div>

		{# Pagination #}
		{# Pagination #}
		<div class="d-flex justify-content-center mt-5">
			<ul class="pagination">

				{% if produits.currentPageNumber > 1 %}
					<li class="page-item">
						<a class="page-link" href="{{ path('app_lister', app.request.query.all|merge({'page': produits.currentPageNumber - 1})) }}" style="background:#111; border-color:#333; color:#fff;">←</a>
					</li>
				{% endif %}

				{% for page in produits.paginationData.pagesInRange %}
					<li class="page-item">
						<a class="page-link" href="{{ path('app_lister', app.request.query.all|merge({'page': page})) }}" style="background:{{ page == produits.currentPageNumber ? '#1D9E75' : '#111' }};
								                          border-color:#333; color:#fff;">
							{{ page }}
						</a>
					</li>
				{% endfor %}

				{% if produits.currentPageNumber < produits.pageCount %}
					<li class="page-item">
						<a class="page-link" href="{{ path('app_lister', app.request.query.all|merge({'page': produits.currentPageNumber + 1})) }}" style="background:#111; border-color:#333; color:#fff;">→</a>
					</li>
				{% endif %}

			</ul>
		</div>

		<p class="text-center text-muted mt-2" style="font-size:13px;">
			Page
			{{ produits.currentPageNumber }}
			sur
			{{ produits.pageCount }}
			—
			{{ produits.totalItemCount }}
			produit{{ produits.totalItemCount > 1 ? 's' : '' }}
			au total
		</p>

	</div>
{% endblock %}
